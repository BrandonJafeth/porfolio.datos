---
/** Avance público en la ruta de 26 semanas. Fuente: src/data/ruta.json (semanas completadas: a mano). */
import Layout from "@/layouts/Layout.astro"
import { ruta, resumenRuta } from "@/lib/ruta"
import { obtenerCasos, urlCaso } from "@/lib/casos"
import { fecha } from "@/lib/formato"

const r = resumenRuta()
const casos = await obtenerCasos()
const publicados = casos.filter((c) => c.data.estado === "publicado")
const semanas = Array.from({ length: ruta.totalSemanas }, (_, i) => i + 1)
const faseDe = (s: number) => ruta.fases.find((f) => s >= f.semanas[0] && s <= f.semanas[1])
const fin = ruta.fin ?? new Date(ruta.inicio.getTime() + ruta.totalSemanas * 7 * 86_400_000)

type EstadoSemana = "hecha" | "actual" | "colchon" | "atrasada" | "pendiente"
const estadoSemana = (s: number): EstadoSemana =>
  r.hechas.has(s) ? "hecha" : r.colchon.has(s) ? "colchon" : s === r.actual ? "actual" : s < r.actual ? "atrasada" : "pendiente"

const textoEstado: Record<EstadoSemana, string> = {
  hecha: "completada",
  actual: "en curso",
  colchon: "colchón",
  atrasada: "por cerrar",
  pendiente: "por venir",
}

const estadoFase = (f: (typeof ruta.fases)[number]) => {
  const propias = semanas.filter((s) => s >= f.semanas[0] && s <= f.semanas[1])
  const n = propias.filter((s) => r.hechas.has(s)).length
  if (n === propias.length) return { texto: "Completa", clase: "completa" }
  if (r.actual >= f.semanas[0] && r.actual <= f.semanas[1]) return { texto: `En curso, ${n} de ${propias.length}`, clase: "en-curso" }
  if (n > 0) return { texto: `${n} de ${propias.length} semanas`, clase: "en-curso" }
  return { texto: r.actual > f.semanas[1] ? "Por cerrar" : "Por venir", clase: "pendiente" }
}

const semanaTexto = !r.empezo ? "Empieza el lunes" : r.termino ? "Terminada" : `Semana ${r.actual} de ${r.total}`
const digitos = String(Math.min(Math.max(r.actual, 0), r.total)).padStart(2, "0").split("")
---

<Layout
  title="Ruta de 26 semanas"
  description="Mi avance público en la ruta de análisis de datos: fases, semanas completadas y casos publicados."
>
  <div class="contenedor pt-12 sm:pt-16">
    <header class="max-w-3xl">
      <h1 class="text-5xl sm:text-7xl">Ruta de {ruta.totalSemanas} semanas</h1>
      <p class="medida mt-4 text-xl text-tinta-2">
        Del {fecha(ruta.inicio)} al {fecha(fin)}. Cada fase termina en un caso publicado.
      </p>
    </header>

    <section class="avance mt-10" aria-labelledby="avance-t">
      <h2 id="avance-t" class="sr-only">Avance</h2>
      <div class="campos">
        <div class="p-4">
          <span class="etiqueta">Semana actual</span>
          <p class="mt-2 flex items-center gap-3">
            {r.empezo && <span class="casillas" aria-hidden="true">{digitos.map((d) => <span>{d}</span>)}</span>}
            <span class="text-lg font-semibold">{semanaTexto}{!r.empezo && ` ${fecha(ruta.inicio)}`}</span>
          </p>
        </div>
        <div class="p-4">
          <span class="etiqueta">Semanas completadas</span>
          <p class="mt-1 text-lg"><span class="num text-3xl font-extrabold text-pluma">{r.hechas.size}</span> de {r.total}</p>
        </div>
        <div class="p-4">
          <span class="etiqueta">Casos publicados</span>
          <p class="mt-1 text-lg"><span class="num text-3xl font-extrabold text-pluma">{publicados.length}</span> de {ruta.fases.filter((f) => f.caso).length} planeados</p>
        </div>
      </div>

      <div class="border-t border-forma p-4">
        <span class="etiqueta mb-3">Calendario</span>
        <ol class="semanas" aria-label="Semanas de la ruta">
          {
            semanas.map((s) => {
              const e = estadoSemana(s)
              const f = faseDe(s)
              return (
                <li class:list={["semana", e]} title={`Semana ${s}${f ? `: ${f.nombre}` : ""}`}>
                  <span class="sr-only">
                    Semana {s}, {textoEstado[e]}
                    {f ? `, ${f.nombre}` : ""}
                  </span>
                  <span aria-hidden="true" class="num">{s}</span>
                </li>
              )
            })
          }
        </ol>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-tinta-2" aria-label="Leyenda">
          <li class="inline-flex items-center gap-1.5"><span class="muestra hecha"></span> Completada</li>
          <li class="inline-flex items-center gap-1.5"><span class="muestra actual"></span> Esta semana</li>
          <li class="inline-flex items-center gap-1.5"><span class="muestra colchon"></span> Colchón (fin de año, Semana Santa)</li>
          <li class="inline-flex items-center gap-1.5"><span class="muestra pendiente"></span> Por venir</li>
        </ul>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="fases-t">
      <h2 id="fases-t" class="text-[2rem] sm:text-[2.6rem]">Fases</h2>
      <ol class="fases mt-6">
        {
          ruta.fases.map((f) => {
            const e = estadoFase(f)
            const delaFase = casos.filter((c) => c.data.fase === f.numero)
            return (
              <li class="fase">
                <div>
                  <p class="num text-lg font-extrabold text-forma-t">F{f.numero}</p>
                  <p class="text-base text-tinta-3">
                    {f.semanas[0] === f.semanas[1] ? `Semana ${f.semanas[0]}` : `Semanas ${f.semanas[0]} a ${f.semanas[1]}`}
                  </p>
                </div>
                <div class="min-w-0">
                  <h3 class="text-[1.4rem]">{f.nombre}</h3>
                  {f.objetivo && <p class="medida mt-1 text-lg text-tinta-2">{f.objetivo}</p>}
                  {delaFase.length > 0 ? (
                    <ul class="mt-2 space-y-1 text-lg">
                      {delaFase.map((c) => (
                        <li>
                          <span class="text-tinta-3">Caso:</span>{" "}
                          <a href={urlCaso(c)} class="text-pluma underline">
                            {c.data.pregunta}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    f.caso && (
                      <p class="mt-2 text-lg text-tinta-2">
                        <span class="text-tinta-3">Caso:</span>{" "}
                        {f.caso.url ? (
                          <a href={f.caso.url} class="text-pluma underline">
                            {f.caso.titulo}
                          </a>
                        ) : (
                          f.caso.titulo
                        )}
                        {f.caso.fuente && <span class="text-tinta-3"> ({f.caso.fuente})</span>}
                      </p>
                    )
                  )}
                </div>
                <p class:list={["estado", `estado-${e.clase}`]}>{e.texto}</p>
              </li>
            )
          })
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  .avance,
  .fases {
    border: 2px solid var(--forma);
  }
  .campos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .campos > div + div {
    border-top: 1px solid var(--forma);
  }
  @media (min-width: 48rem) {
    .campos {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
    .campos > div + div {
      border-top: 0;
      border-left: 1px solid var(--forma);
    }
  }
  .semanas {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    border: 1.5px solid var(--forma-fuerte);
  }
  .semana {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-right: 1px solid var(--forma);
    font-size: 0.85rem;
    color: var(--tinta-3);
  }
  .semana:nth-child(13n) {
    border-right: 0;
  }
  .semana:nth-child(n + 14) {
    border-top: 1px solid var(--forma);
  }
  .muestra {
    display: inline-block;
    width: 0.95rem;
    height: 0.95rem;
    border: 1.5px solid var(--forma-fuerte);
  }
  .hecha {
    background: var(--pluma);
    color: var(--pluma-ink);
    font-weight: 700;
  }
  .muestra.hecha {
    border-color: var(--pluma);
  }
  .actual {
    box-shadow: inset 0 0 0 3px var(--pluma);
    color: var(--pluma);
    font-weight: 800;
  }
  .colchon {
    background: repeating-linear-gradient(135deg, var(--forma-f) 0 5px, var(--papel) 5px 9px);
    color: var(--forma-t);
  }
  .atrasada {
    color: var(--nivel-media);
    font-weight: 700;
  }
  @media (max-width: 30rem) {
    .semanas {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
    .semana:nth-child(13n) {
      border-right: 1px solid var(--forma);
    }
    .semana:nth-child(7n) {
      border-right: 0;
    }
    .semana:nth-child(n + 8) {
      border-top: 1px solid var(--forma);
    }
  }
  .fase {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding: 1rem 1.1rem 1.15rem;
  }
  .fase + .fase {
    border-top: 1px solid var(--forma);
  }
  @media (min-width: 48rem) {
    .fase {
      grid-template-columns: 8rem minmax(0, 1fr) 10rem;
    }
    .estado {
      text-align: right;
    }
  }
  .estado {
    font-size: 1rem;
    font-weight: 700;
  }
  .estado-completa {
    color: var(--pluma);
  }
  .estado-en-curso {
    color: var(--nivel-media);
  }
  .estado-pendiente {
    color: var(--tinta-3);
  }
</style>
