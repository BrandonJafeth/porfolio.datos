---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/inicio/Hero.astro"
import Flujo from "@/components/inicio/Flujo.astro"
import Seccion from "@/components/Seccion.astro"
import TarjetaCaso from "@/components/caso/TarjetaCaso.astro"
import Mail from "@/components/icons/Mail.astro"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import { obtenerCasos } from "@/lib/casos"
import Certificaciones from "@/components/inicio/Certificaciones.astro"
import { PERFIL, SITIO, EXPERIENCIA, EDUCACION, LINKS_CREDENCIALES, esPendiente } from "@/data/perfil"

const casos = (await obtenerCasos()).slice(0, 3)

const sameAs = [PERFIL.enlaces.linkedin, PERFIL.enlaces.github, ...LINKS_CREDENCIALES].filter((u) => !esPendiente(u))
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: PERFIL.nombre,
    url: SITIO.url,
    jobTitle: PERFIL.cargo,
    description: SITIO.descripcion,
    address: {
      "@type": "PostalAddress",
      addressLocality: PERFIL.ciudad,
      addressRegion: PERFIL.provincia,
      addressCountry: { "@type": "Country", name: "Costa Rica" },
    },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Universidad Nacional de Costa Rica" },
    knowsAbout: ["SQL", "Python", "Power BI", "Análisis de datos", "Visualización de datos"],
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITIO.nombre,
    url: SITIO.url,
    inLanguage: "es-CR",
  },
]

const email = PERFIL.enlaces.email
---

<Layout title={SITIO.tituloInicio} tituloExacto description={SITIO.descripcion} jsonLd={jsonLd}>
  <Hero />

  <Seccion id="casos" titulo="Casos" nota="Preguntas respondidas con datos" accion={casos.length ? { texto: "Ver todos los casos", url: "/casos/" } : undefined}>
    {
      casos.length ? (
        <div class="border-b border-forma">
          {casos.map((c) => <TarjetaCaso caso={c} nivel={3} />)}
        </div>
      ) : (
        <div class="vacio p-6 sm:p-8">
          <span class="etiqueta">Pregunta 1</span>
          <p class="mt-1 text-2xl font-bold sm:text-3xl" style="font-family: var(--font-titulo); font-stretch: 112%">El primer caso está en camino.</p>
          <p class="mt-2 text-lg text-tinta-2">Cada caso responde una pregunta real con datos públicos de Costa Rica.</p>
          <a href="/ruta/" class="mt-4 inline-block font-bold text-pluma underline decoration-2 underline-offset-4">Ver mi ruta de datos</a>
        </div>
      )
    }
  </Seccion>

  <Seccion id="como-trabajo" titulo="Cómo trabajo">
    <Flujo />
  </Seccion>

  <Seccion id="sobre-mi" titulo="Experiencia">
    <ol class="tabla-forma">
      {
        EXPERIENCIA.map((e) => (
          <li class="fila-exp">
            <p class="num text-base font-semibold text-forma-t">{esPendiente(e.periodo) ? "" : e.periodo}</p>
            <div class="min-w-0">
              <h3 class="text-[1.45rem]">{e.rol}</h3>
              <p class="text-lg font-semibold text-tinta-2">{e.organizacion}</p>
              <p class="medida mt-1.5 text-lg text-tinta-2">{e.resumen}</p>
              <p class="mt-2 text-base text-tinta-3">Con {e.etiquetas.join(", ")}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion id="formacion" titulo="Educación y certificaciones">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-12">
      <div>
        <h3 class="mb-3 text-xl">Educación</h3>
        <ul class="tabla-forma">
          {
            EDUCACION.map((c) => (
              <li class="py-3.5">
                <p class="text-lg font-bold leading-snug">{c.nombre}</p>
                <p class="text-base text-tinta-2">
                  {c.emisor}, {c.estado === "en curso" ? <span class="font-semibold text-pluma">en curso</span> : <span class="num">{c.anio}</span>}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="mb-3 text-xl">Certificaciones</h3>
        <Certificaciones />
      </div>
    </div>
  </Seccion>

  <Seccion id="contacto" titulo="Contacto">
    <div class="contacto-campo grid gap-6 p-5 sm:p-7 md:grid-cols-[minmax(0,1.4fr)_auto] md:items-end">
      <div>
        <span class="etiqueta">Su pregunta</span>
        <p class="mt-1 text-[1.6rem] font-bold leading-tight text-pluma sm:text-[2.1rem]" style="font-family: var(--font-titulo)">
          ¿Tenés una pregunta que los datos públicos podrían responder? Contame.
        </p>
      </div>
      <ul class="flex flex-wrap gap-3 md:justify-end">
        {
          !esPendiente(email) && (
            <li>
              <a href={`mailto:${email}`} class="boton boton-lleno">
                <Mail class="size-5" /> Escribime
              </a>
            </li>
          )
        }
        {
          !esPendiente(PERFIL.enlaces.linkedin) && (
            <li>
              <a href={PERFIL.enlaces.linkedin} rel="noopener" class:list={["boton", esPendiente(email) && "boton-lleno"]}>
                <LinkedIn class="size-5" /> LinkedIn
              </a>
            </li>
          )
        }
        {
          import.meta.env.DEV && esPendiente(email) && (
            <li class="font-mono text-sm text-nivel-media">Falta TODO_EMAIL en src/data/perfil.ts</li>
          )
        }
      </ul>
    </div>
  </Seccion>
</Layout>

<style>
  .tabla-forma {
    border-top: 1px solid var(--forma);
  }
  .tabla-forma > li {
    border-bottom: 1px solid var(--forma);
  }
  .fila-exp {
    display: grid;
    gap: 0.35rem 2rem;
    padding-block: 1.1rem 1.2rem;
  }
  @media (min-width: 48rem) {
    .fila-exp {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }
  .vacio {
    border: 2px solid var(--forma);
    background: var(--forma-f);
  }
  .contacto-campo {
    border-top: 1px solid var(--forma);
    padding-inline: 0 !important;
  }
</style>
