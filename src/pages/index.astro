---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/inicio/Hero.astro"
import Flujo from "@/components/inicio/Flujo.astro"
import Seccion from "@/components/Seccion.astro"
import TarjetaCaso from "@/components/caso/TarjetaCaso.astro"
import Mail from "@/components/icons/Mail.astro"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import { obtenerCasos } from "@/lib/casos"
import Certificaciones from "@/components/inicio/Certificaciones.astro"
import { PERFIL, SITIO, EXPERIENCIA, EDUCACION, LINKS_CREDENCIALES, esPendiente } from "@/data/perfil"

const casos = (await obtenerCasos()).slice(0, 3)

const sameAs = [PERFIL.enlaces.linkedin, PERFIL.enlaces.github, ...LINKS_CREDENCIALES].filter((u) => !esPendiente(u))
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: PERFIL.nombre,
    url: SITIO.url,
    jobTitle: PERFIL.cargo,
    description: SITIO.descripcion,
    address: {
      "@type": "PostalAddress",
      addressLocality: PERFIL.ciudad,
      addressRegion: PERFIL.provincia,
      addressCountry: { "@type": "Country", name: "Costa Rica" },
    },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Universidad Nacional de Costa Rica" },
    knowsAbout: ["SQL", "Python", "Power BI", "Análisis de datos", "Visualización de datos"],
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITIO.nombre,
    url: SITIO.url,
    inLanguage: "es-CR",
  },
]

const email = PERFIL.enlaces.email
---

<Layout title={SITIO.tituloInicio} tituloExacto description={SITIO.descripcion} jsonLd={jsonLd}>
  <Hero />

  <Seccion id="casos" titulo="Casos destacados" accion={casos.length ? { texto: "Todos los casos", url: "/casos/" } : undefined}>
    {
      casos.length ? (
        <div class="border-b border-rule">
          {casos.map((c) => <TarjetaCaso caso={c} nivel={3} />)}
        </div>
      ) : (
        <div class="vacio grid gap-6 rounded-md border border-dashed border-rule p-8 sm:grid-cols-[1fr_auto] sm:items-center sm:p-10">
          <div>
            <p class="font-serif text-2xl sm:text-3xl">El primer caso está en camino.</p>
            <p class="mt-2 text-lg text-ink-2">Cada caso responde una pregunta real con datos públicos de Costa Rica.</p>
          </div>
          <a href="/ruta/" class="font-bold text-accent underline">Ver mi avance</a>
        </div>
      )
    }
  </Seccion>

  <Seccion id="como-trabajo" titulo="Cómo trabajo">
    <Flujo />
  </Seccion>

  <Seccion id="sobre-mi" titulo="Experiencia">
    <ol class="divide-y divide-rule">
      {
        EXPERIENCIA.map((e) => (
          <li class="grid gap-x-10 gap-y-1 py-6 first:pt-0 md:grid-cols-[13rem_minmax(0,1fr)]">
            <p class="num text-base text-ink-3">{esPendiente(e.periodo) ? "" : e.periodo}</p>
            <div>
              <h3 class="text-2xl">
                {e.rol} <span class="font-sans text-lg font-normal text-ink-2">· {e.organizacion}</span>
              </h3>
              <p class="medida mt-1.5 text-lg text-ink-2">{e.resumen}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Habilidades">
                {e.etiquetas.map((t) => <li class="rounded-full border border-rule px-2.5 py-0.5 text-sm text-ink-2">{t}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion id="formacion" titulo="Educación y certificaciones">
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <h3 class="versalitas mb-3 text-base text-ink-2">Educación</h3>
        <ul class="divide-y divide-rule border-y border-rule">
          {
            EDUCACION.map((c) => (
              <li class="py-4">
                <p class="text-lg font-bold leading-snug">{c.nombre}</p>
                <p class="text-base text-ink-2">
                  {c.emisor} · {c.estado === "en curso" ? <span class="text-accent">En curso</span> : <span class="num">{c.anio}</span>}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="versalitas mb-3 text-base text-ink-2">Certificaciones</h3>
        <Certificaciones />
      </div>
    </div>
  </Seccion>

  <Seccion id="contacto" titulo="Contacto">
    <div class="grid gap-8 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:items-end">
      <p class="font-serif text-3xl leading-tight sm:text-[2.6rem]">
        ¿Tenés una pregunta que los datos públicos podrían responder? Hablemos.
      </p>
      <ul class="flex flex-wrap gap-3 md:justify-end">
        {
          !esPendiente(email) && (
            <li>
              <a href={`mailto:${email}`} class="contacto contacto-principal">
                <Mail class="size-5" /> Escribime
              </a>
            </li>
          )
        }
        {
          !esPendiente(PERFIL.enlaces.linkedin) && (
            <li>
              <a href={PERFIL.enlaces.linkedin} rel="noopener" class="contacto">
                <LinkedIn class="size-5" /> LinkedIn
              </a>
            </li>
          )
        }
        {
          import.meta.env.DEV && esPendiente(email) && (
            <li class="font-mono text-sm text-nivel-media">Falta TODO_EMAIL y TODO_LINKEDIN_URL en src/data/perfil.ts</li>
          )
        }
      </ul>
    </div>
  </Seccion>
</Layout>

<style>
  .contacto {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    font-weight: 650;
    text-decoration: none;
  }
  .contacto:hover {
    border-color: var(--ink);
  }
  .contacto-principal {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .contacto-principal:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }
</style>
