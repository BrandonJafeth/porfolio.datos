---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Página no encontrada" description="Esta página no existe." noindex>
  <div class="contenedor py-24 sm:py-32">
    <p class="num font-serif text-8xl leading-none text-accent">404</p>
    <h1 class="mt-6 max-w-[18ch] text-4xl sm:text-6xl">Esta pregunta no tiene respuesta… todavía.</h1>
    <p class="medida mt-4 text-xl text-ink-2">La página que buscás no existe o cambió de dirección.</p>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-lg">
      <a href="/" class="font-bold text-accent underline">Ir al inicio</a>
      <a href="/casos/" class="font-bold text-accent underline">Ver los casos</a>
    </p>
  </div>
</Layout>
