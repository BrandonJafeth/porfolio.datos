---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Página no encontrada" description="Esta página no existe." noindex>
  <div class="contenedor py-16 sm:py-24">
    <div class="boleta-404 max-w-[46rem]">
      <div class="p-5 sm:p-6">
        <span class="etiqueta">Pregunta</span>
        <h1 class="mt-1 text-4xl sm:text-5xl">¿Dónde está esta página?</h1>
      </div>
      <div class="respuesta p-5 sm:p-6">
        <span class="etiqueta">Respuesta</span>
        <p class="mt-1 text-2xl font-semibold text-pluma">No existe o cambió de dirección. Error <span class="num">404</span>.</p>
      </div>
    </div>
    <p class="mt-6 flex flex-wrap gap-3">
      <a href="/" class="boton boton-lleno">Ir al inicio</a>
      <a href="/casos/" class="boton">Ver los casos</a>
    </p>
  </div>
</Layout>

<style>
  .boleta-404 {
    border: 2px solid var(--forma);
  }
  .respuesta {
    border-top: 1px solid var(--forma);
    background: var(--forma-f);
  }
</style>
