---
import { render } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import ToggleLectura from "@/components/caso/ToggleLectura.astro"
import CifraClave from "@/components/caso/CifraClave.astro"
import Confianza from "@/components/caso/Confianza.astro"
import CapaTecnica from "@/components/caso/CapaTecnica.astro"
import TextoGlosario from "@/components/caso/TextoGlosario.astro"
import Termino from "@/components/caso/Termino.astro"
import Grafico from "@/components/graficos/Grafico.astro"
import GraficoLinea from "@/components/graficos/GraficoLinea.astro"
import GraficoBarras from "@/components/graficos/GraficoBarras.astro"
import Anotacion from "@/components/graficos/Anotacion.astro"
import Fuente from "@/components/graficos/Fuente.astro"
import ArrowRight from "@/components/icons/ArrowRight.astro"
import GitHub from "@/components/icons/GitHub.astro"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import { obtenerCasos, textoPlano, contarPalabras, urlCaso, type Caso } from "@/lib/casos"
import { cargarGrafico, tieneDatosFicticios } from "@/lib/datos"
import { fecha } from "@/lib/formato"
import { PERFIL, SITIO } from "@/data/perfil"
import { slugHerramienta } from "@/lib/herramientas"

export async function getStaticPaths() {
  const casos = await obtenerCasos()
  return casos.map((caso, i) => ({
    params: { slug: caso.id },
    props: { caso, siguiente: casos.length > 1 ? casos[(i + 1) % casos.length] : undefined },
  }))
}

interface Props {
  caso: Caso
  siguiente?: Caso
}

const { caso, siguiente } = Astro.props
const { data } = caso
const { Content } = await render(caso)
const grafico = cargarGrafico(caso.id, data.graficoPrincipal)
const ficticio = tieneDatosFicticios(caso.id)

// Regla: antes de la capa técnica, el caso se lee en menos de 1 minuto (~200 palabras).
const palabras = [
  data.pregunta,
  data.respuestaCorta,
  ...data.cifras.flatMap((c) => [c.valor, c.etiqueta, c.significado]),
  grafico.titulo,
  ...data.porQueImporta,
  data.confianzaMotivo ?? "",
].reduce((n, t) => n + contarPalabras(t), 0)
if (palabras > 200) {
  console.warn(`[legibilidad] "${caso.id}": ${palabras} palabras antes de la capa técnica (máx. ~200).`)
}
const minutos = Math.max(1, Math.round(palabras / 200))

const url = new URL(urlCaso(caso), Astro.site ?? SITIO.url).toString()
const ogImage = `/casos/${caso.id}/og.png`
const descripcion = textoPlano(data.respuestaCorta)

const autor = { "@type": "Person", name: PERFIL.nombre, url: SITIO.url }
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.pregunta,
    alternativeHeadline: data.titulo,
    description: descripcion,
    datePublished: data.fecha.toISOString(),
    inLanguage: "es-CR",
    author: autor,
    publisher: autor,
    image: new URL(ogImage, SITIO.url).toString(),
    mainEntityOfPage: url,
    keywords: [data.tema, ...data.herramientas].join(", "),
    isBasedOn: data.fuentes.map((f) => f.url),
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: grafico.titulo,
    description: grafico.resumen,
    creator: autor,
    isAccessibleForFree: true,
    inLanguage: "es-CR",
    spatialCoverage: { "@type": "Place", name: "Costa Rica" },
    isBasedOn: data.fuentes.map((f) => ({ "@type": "Dataset", name: f.nombre, url: f.url })),
    url,
  },
]
---

<Layout
  title={data.pregunta}
  description={descripcion}
  image={ogImage}
  imageAlt={`${data.pregunta} ${descripcion}`}
  type="article"
  publishedTime={data.fecha}
  jsonLd={jsonLd}
  noindex={data.estado === "borrador"}
>
  <article class="contenedor pt-6 sm:pt-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <nav aria-label="Ruta de navegación" class="text-base text-ink-2">
        <a href="/casos/" class="underline decoration-rule hover:text-ink">Casos</a>
        <span aria-hidden="true" class="mx-1.5 text-ink-3">/</span>
        <a href={`/casos/tema/${slugHerramienta(data.tema)}/`} class="underline decoration-rule hover:text-ink">{data.tema}</a>
      </nav>
      <ToggleLectura />
    </div>

    <header class="mt-10 max-w-[46rem] sm:mt-16">
      {
        (data.estado === "borrador" || ficticio) && (
          <p class="aviso mb-6 rounded-md px-3 py-2 text-base">
            <strong>{data.estado === "borrador" ? "Borrador" : "Aviso"}.</strong>
            {ficticio ? " Este caso usa datos ficticios de muestra. No los cites." : " No se publica en producción."}
          </p>
        )
      }
      <h1
        class="pregunta text-[2.6rem] leading-[1.04] tracking-[-0.025em] sm:text-6xl md:text-[4.25rem]"
        style={`view-transition-name: pregunta-${caso.id}`}
      >
        {data.pregunta}
      </h1>
      <p class="solo-tecnico mt-4 font-serif text-xl italic text-ink-2">{data.titulo}</p>

      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-base text-ink-3">
        <span class="versalitas text-ink-2">{PERFIL.ciudad}, {PERFIL.provincia}</span>
        <time datetime={data.fecha.toISOString()}>{fecha(data.fecha)}</time>
        <span>Lectura: {minutos} min</span>
        <a href="#como-lo-hice" class="text-accent underline">Ir al método</a>
      </p>

      <p class="respuesta mt-8 text-[1.6rem] font-medium leading-[1.35] tracking-[-0.005em] sm:text-[2rem]">
        <span class="resaltado trazo"><TextoGlosario texto={data.respuestaCorta} /></span>
      </p>
    </header>

    <section aria-labelledby="cifras-t" class="mt-14 sm:mt-20">
      <h2 id="cifras-t" class="sr-only">Cifras clave</h2>
      <dl class:list={["grid gap-x-8 gap-y-10 sm:grid-cols-2", data.cifras.length === 3 && "lg:grid-cols-3", data.cifras.length === 4 && "lg:grid-cols-4"]}>
        {data.cifras.map((c, i) => <CifraClave {...c} destacada={i === 0} />)}
      </dl>
    </section>

    <section class="mt-16 max-w-[60rem] sm:mt-24">
      <Grafico slug={caso.id} archivo={data.graficoPrincipal} nivel={2} />
    </section>

    <div class="mt-16 grid max-w-[60rem] gap-14 sm:mt-24 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-16">
      <section aria-labelledby="importa-t">
        <h2 id="importa-t" class="text-3xl sm:text-4xl">¿Por qué te importa?</h2>
        <ul class="importa mt-6 space-y-4">
          {
            data.porQueImporta.map((p) => (
              <li class="medida pl-8 text-lg leading-snug sm:text-xl">
                <TextoGlosario texto={p} />
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="confianza-t" class="md:pt-2">
        <h2 id="confianza-t" class="text-2xl">¿Qué tan seguro es?</h2>
        <div class="mt-5">
          <Confianza nivel={data.confianza} motivo={data.confianzaMotivo} />
        </div>
        <p class="mt-5 text-base text-ink-2">Pensado para: {data.audiencia.toLowerCase()}.</p>
      </section>
    </div>

    <div class="mt-16 max-w-[60rem] sm:mt-24">
      <CapaTecnica limitaciones={data.limitaciones} fuentes={data.fuentes} repo={data.repo} herramientas={data.herramientas}>
        <Content components={{ Termino, GraficoLinea, GraficoBarras, Grafico, Anotacion, Fuente }} />
      </CapaTecnica>
    </div>

    <footer class="mt-16 grid max-w-[60rem] gap-10 md:grid-cols-2">
      <div class="space-y-4">
        <h2 class="text-2xl">Compartí y revisá</h2>
        <div class="flex flex-wrap gap-3">
          <a href={data.repo} rel="noopener" class="boton">
            <GitHub class="size-5" /> Repositorio
          </a>
          {
            data.postLinkedIn && (
              <a href={data.postLinkedIn} rel="noopener" class="boton">
                <LinkedIn class="size-5" /> Comentá en LinkedIn
              </a>
            )
          }
        </div>
        <ul class="space-y-1">
          {data.fuentes.map((f) => <li><Fuente nombre={f.nombre} url={f.url} /></li>)}
        </ul>
      </div>
      {
        siguiente && (
          <a href={urlCaso(siguiente)} class="siguiente group block border-t-2 border-rule-strong pt-4 no-underline">
            <span class="versalitas text-sm text-ink-2">Siguiente caso</span>
            <span class="mt-2 block font-serif text-2xl leading-tight text-ink transition-colors group-hover:text-accent sm:text-3xl">
              {siguiente.data.pregunta}
            </span>
            <span class="mt-3 inline-flex items-center gap-1 font-bold text-accent">
              Leer <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        )
      }
    </footer>
  </article>
</Layout>

<style>
  .respuesta {
    max-width: 30ch;
  }
  .aviso {
    background: color-mix(in oklab, var(--nivel-media) 14%, transparent);
    color: var(--ink);
  }
  .importa li {
    position: relative;
  }
  .importa li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 1rem;
    height: 2px;
    background: var(--accent);
  }
  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 200ms var(--ease-salida), background 200ms var(--ease-salida);
  }
  .boton:hover {
    border-color: var(--ink);
    background: var(--paper-2);
  }
</style>
