---
import { render } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import ToggleLectura from "@/components/caso/ToggleLectura.astro"
import CifraClave from "@/components/caso/CifraClave.astro"
import Confianza from "@/components/caso/Confianza.astro"
import CapaTecnica from "@/components/caso/CapaTecnica.astro"
import TextoGlosario from "@/components/caso/TextoGlosario.astro"
import Termino from "@/components/caso/Termino.astro"
import Grafico from "@/components/graficos/Grafico.astro"
import GraficoLinea from "@/components/graficos/GraficoLinea.astro"
import GraficoBarras from "@/components/graficos/GraficoBarras.astro"
import Anotacion from "@/components/graficos/Anotacion.astro"
import Fuente from "@/components/graficos/Fuente.astro"
import GitHub from "@/components/icons/GitHub.astro"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import { obtenerCasos, textoPlano, contarPalabras, urlCaso, numerarCasos, type Caso } from "@/lib/casos"
import { cargarGrafico, tieneDatosFicticios } from "@/lib/datos"
import { fecha } from "@/lib/formato"
import { PERFIL, SITIO } from "@/data/perfil"
import { slugHerramienta } from "@/lib/herramientas"

export async function getStaticPaths() {
  const casos = await obtenerCasos()
  return casos.map((caso, i) => ({
    params: { slug: caso.id },
    props: { caso, siguiente: casos.length > 1 ? casos[(i + 1) % casos.length] : undefined },
  }))
}

interface Props {
  caso: Caso
  siguiente?: Caso
}

const { caso, siguiente } = Astro.props
const { data } = caso
const { Content } = await render(caso)
const numeros = numerarCasos(await obtenerCasos())
const n = numeros.get(caso.id) ?? 0
const grafico = cargarGrafico(caso.id, data.graficoPrincipal)
const ficticio = tieneDatosFicticios(caso.id)

// Regla: antes de la capa técnica, el caso se lee en menos de 1 minuto (~200 palabras).
const palabras = [
  data.pregunta,
  data.respuestaCorta,
  ...data.cifras.flatMap((c) => [c.valor, c.etiqueta, c.significado]),
  grafico.titulo,
  ...data.porQueImporta,
  data.confianzaMotivo ?? "",
].reduce((n, t) => n + contarPalabras(t), 0)
if (palabras > 200) {
  console.warn(`[legibilidad] "${caso.id}": ${palabras} palabras antes de la capa técnica (máx. ~200).`)
}
const minutos = Math.max(1, Math.round(palabras / 200))

const url = new URL(urlCaso(caso), Astro.site ?? SITIO.url).toString()
const ogImage = `/casos/${caso.id}/og.png`
const descripcion = textoPlano(data.respuestaCorta)

const autor = { "@type": "Person", name: PERFIL.nombre, url: SITIO.url }
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.pregunta,
    alternativeHeadline: data.titulo,
    description: descripcion,
    datePublished: data.fecha.toISOString(),
    inLanguage: "es-CR",
    author: autor,
    publisher: autor,
    image: new URL(ogImage, SITIO.url).toString(),
    mainEntityOfPage: url,
    keywords: [data.tema, ...data.herramientas].join(", "),
    isBasedOn: data.fuentes.map((f) => f.url),
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: grafico.titulo,
    description: grafico.resumen,
    creator: autor,
    isAccessibleForFree: true,
    inLanguage: "es-CR",
    spatialCoverage: { "@type": "Place", name: "Costa Rica" },
    isBasedOn: data.fuentes.map((f) => ({ "@type": "Dataset", name: f.nombre, url: f.url })),
    url,
  },
]
---

<Layout
  title={data.pregunta}
  description={descripcion}
  image={ogImage}
  imageAlt={`${data.pregunta} ${descripcion}`}
  type="article"
  publishedTime={data.fecha}
  jsonLd={jsonLd}
  noindex={data.estado === "borrador"}
>
  <article class="contenedor pt-6 sm:pt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <nav aria-label="Ruta de navegación" class="text-base text-tinta-2">
        <a href="/casos/" class="underline decoration-forma-fuerte hover:text-tinta">Casos</a>
        <span aria-hidden="true" class="mx-1.5 text-forma-t">/</span>
        <a href={`/casos/tema/${slugHerramienta(data.tema)}/`} class="underline decoration-forma-fuerte hover:text-tinta">{data.tema}</a>
        <span aria-hidden="true" class="mx-1.5 text-forma-t">/</span>
        <span>Pregunta {n}</span>
      </nav>
      <ToggleLectura />
    </div>

    {
      (data.estado === "borrador" || ficticio) && (
        <p class="aviso mt-8 max-w-[46rem] px-3 py-2 text-base">
          <strong>{data.estado === "borrador" ? "Borrador." : "Aviso."}</strong>
          {ficticio ? " Este caso usa datos ficticios de muestra. No los cites." : " No se publica en producción."}
        </p>
      )
    }

    <header class="encabezado mt-8 sm:mt-12">
      <p class="numero num" aria-hidden="true">P{n}</p>
      <div class="min-w-0">
        <h1 class="pregunta" style={`view-transition-name: pregunta-${caso.id}`}>{data.pregunta}</h1>
        <p class="solo-tecnico mt-3 text-lg text-tinta-2"><span class="font-semibold text-forma-t">Título técnico:</span> {data.titulo}</p>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-base text-tinta-3">
          <time datetime={data.fecha.toISOString()}>{fecha(data.fecha)}</time>
          <span>Lectura de {minutos} min</span>
          <a href="#como-lo-hice" class="font-semibold text-pluma underline">Ir al método</a>
        </p>
      </div>
    </header>

    <div class="respuesta-campo mt-8 max-w-[46rem]">
      <span class="etiqueta">Respuesta</span>
      <p class="respuesta escribir"><TextoGlosario texto={data.respuestaCorta} /></p>
    </div>

    <section aria-labelledby="cifras-t" class="mt-12 sm:mt-16">
      <h2 id="cifras-t" class="sr-only">Cifras clave</h2>
      <dl class:list={["cifras", `n-${data.cifras.length}`]}>
        {data.cifras.map((c) => <CifraClave {...c} />)}
      </dl>
    </section>

    <section class="mt-14 max-w-[62rem] sm:mt-20">
      <Grafico slug={caso.id} archivo={data.graficoPrincipal} nivel={2} />
    </section>

    <div class="mt-14 grid max-w-[62rem] gap-10 sm:mt-20 md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] md:gap-12">
      <section aria-labelledby="importa-t">
        <h2 id="importa-t" class="text-[1.8rem] sm:text-[2.2rem]">¿Por qué te importa?</h2>
        <ul class="importa mt-5">
          {
            data.porQueImporta.map((p) => (
              <li>
                <TextoGlosario texto={p} />
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="confianza-t">
        <h2 id="confianza-t" class="text-[1.5rem]">¿Qué tan seguro es?</h2>
        <div class="mt-4">
          <Confianza nivel={data.confianza} motivo={data.confianzaMotivo} />
        </div>
        <p class="mt-4 text-base text-tinta-2"><span class="font-semibold text-forma-t">Pensado para:</span> {data.audiencia.toLowerCase()}.</p>
      </section>
    </div>

    <div class="mt-14 max-w-[62rem] sm:mt-20">
      <CapaTecnica limitaciones={data.limitaciones} fuentes={data.fuentes} repo={data.repo} herramientas={data.herramientas}>
        <Content components={{ Termino, GraficoLinea, GraficoBarras, Grafico, Anotacion, Fuente }} />
      </CapaTecnica>
    </div>

    <footer class="mt-14 grid max-w-[62rem] gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-xl">Revisá y compartí</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href={data.repo} rel="noopener" class="boton">
            <GitHub class="size-5" /> Repositorio
          </a>
          {
            data.postLinkedIn && (
              <a href={data.postLinkedIn} rel="noopener" class="boton">
                <LinkedIn class="size-5" /> Comentá en LinkedIn
              </a>
            )
          }
        </div>
        <ul class="mt-4 space-y-1">
          {data.fuentes.map((f) => <li><Fuente nombre={f.nombre} url={f.url} /></li>)}
        </ul>
      </div>
      {
        siguiente && (
          <a href={urlCaso(siguiente)} class="siguiente block p-4 no-underline">
            <span class="etiqueta">Siguiente pregunta, P{numeros.get(siguiente.id)}</span>
            <span class="titulo-sig">{siguiente.data.pregunta}</span>
            <span class="mt-2 block text-pluma underline">{textoPlano(siguiente.data.respuestaCorta)}</span>
          </a>
        )
      }
    </footer>
  </article>
</Layout>

<style>
  .aviso {
    border: 1.5px solid var(--nivel-media);
    color: var(--tinta);
  }
  .encabezado {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    max-width: 58rem;
  }
  .numero {
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.4rem;
    color: var(--forma-t);
  }
  .pregunta {
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.1rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 800;
  }
  @media (min-width: 48rem) {
    .encabezado {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }
    .numero {
      font-size: 1.9rem;
      line-height: 1.6;
    }
  }
  .respuesta-campo {
    padding: 0.9rem 1.15rem 1.15rem;
    border: 2px solid var(--forma);
    background: var(--forma-f);
  }
  .respuesta {
    margin-top: 0.3rem;
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.95rem);
    font-weight: 620;
    line-height: 1.32;
    color: var(--pluma);
    max-width: 34ch;
  }
  .cifras {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 2px solid var(--forma);
  }
  .cifras > :global(div + div) {
    border-top: 1px solid var(--forma);
  }
  @media (min-width: 48rem) {
    .cifras.n-2,
    .cifras.n-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cifras.n-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cifras > :global(div + div) {
      border-top: 0;
      border-left: 1px solid var(--forma);
    }
    .cifras.n-4 > :global(div:nth-child(3)) {
      border-left: 0;
      border-top: 1px solid var(--forma);
    }
    .cifras.n-4 > :global(div:nth-child(4)) {
      border-top: 1px solid var(--forma);
    }
  }
  @media (min-width: 64rem) {
    .cifras.n-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cifras.n-4 > :global(div:nth-child(n)) {
      border-top: 0;
    }
    .cifras.n-4 > :global(div:nth-child(3)) {
      border-left: 1px solid var(--forma);
    }
  }
  .importa {
    border-top: 1px dashed var(--forma);
  }
  .importa li {
    position: relative;
    padding: 0.75rem 0 0.75rem 2rem;
    border-bottom: 1px dashed var(--forma);
    font-size: 1.15rem;
    line-height: 1.45;
    max-width: 58ch;
  }
  .importa li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.95rem;
    height: 0.95rem;
    border: 1.5px solid var(--forma-fuerte);
  }
  .siguiente {
    border: 2px solid var(--forma);
    transition: border-color 160ms var(--ease-salida);
  }
  .siguiente:hover {
    border-color: var(--pluma);
  }
  .titulo-sig {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-titulo);
    font-stretch: 112%;
    font-weight: 780;
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--tinta);
  }
</style>
