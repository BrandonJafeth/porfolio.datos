---
/** Un indicador económico como campo del formulario (lee un item de src/data/indicadores/latest.json). */
import type { Indicadores } from "@/lib/datos"
import { formatear } from "@/lib/formato"
import { sparkline } from "@/lib/graficos"

interface Props {
  ind: Indicadores["indicadores"][number]
}
const { ind } = Astro.props
const spark = ind.serie ? sparkline(ind.serie, 140, 36) : null
const cambio = ind.cambio
const sube = cambio !== undefined && cambio > 0
const tono =
  cambio === undefined || cambio === 0 || ind.subirEsBueno === null ? "neutro" : sube === ind.subirEsBueno ? "bueno" : "malo"
const textoCambio =
  cambio === undefined ? null : `${cambio > 0 ? "Subió" : cambio < 0 ? "Bajó" : "Sin cambio"} ${cambio !== 0 ? formatear(Math.abs(cambio), ind.cambioFormato ?? ind.formato) : ""}`.trim()
---

<article class="indicador flex flex-col gap-2 p-4" aria-labelledby={`ind-${ind.id}`}>
  <h2 id={`ind-${ind.id}`} class="etiqueta">{ind.nombre}</h2>
  <p class="num text-5xl font-extrabold leading-none text-pluma">{formatear(ind.valor, ind.formato)}</p>
  <div class="flex items-center justify-between gap-3">
    {textoCambio && <p class:list={["text-base font-bold", `tono-${tono}`]}>{textoCambio}</p>}
    {
      spark && (
        <svg width={spark.ancho} height={spark.alto} viewBox={`-2 -2 ${spark.ancho + 4} ${spark.alto + 4}`} class="text-pluma" aria-hidden="true">
          <path d={spark.d} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <rect x={spark.ultimo[0] - 3} y={spark.ultimo[1] - 3} width="6" height="6" fill="currentColor" />
        </svg>
      )
    }
  </div>
  <p class="text-base text-tinta-2">{ind.explicacion}</p>
  <p class="text-sm text-tinta-3">
    {ind.periodo}. Fuente: <a href={ind.fuente.url} rel="noopener" class="underline">{ind.fuente.nombre}</a>
  </p>
</article>

<style>
  .indicador {
    border: 2px solid var(--forma);
  }
  .tono-bueno {
    color: var(--pluma);
  }
  .tono-malo {
    color: var(--nivel-baja);
  }
  .tono-neutro {
    color: var(--tinta-2);
  }
</style>
