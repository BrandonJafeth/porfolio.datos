---
/** Tarjeta de un indicador económico (lee un item de src/data/indicadores/latest.json). */
import type { Indicadores } from "@/lib/datos"
import { formatear } from "@/lib/formato"
import { sparkline } from "@/lib/graficos"

interface Props {
  ind: Indicadores["indicadores"][number]
}
const { ind } = Astro.props
const spark = ind.serie ? sparkline(ind.serie, 140, 36) : null
const cambio = ind.cambio
const sube = cambio !== undefined && cambio > 0
const tono =
  cambio === undefined || cambio === 0 || ind.subirEsBueno === null ? "neutro" : sube === ind.subirEsBueno ? "bueno" : "malo"
const textoCambio =
  cambio === undefined ? null : `${cambio > 0 ? "Subió" : cambio < 0 ? "Bajó" : "Sin cambio"} ${cambio !== 0 ? formatear(Math.abs(cambio), ind.cambioFormato ?? ind.formato) : ""}`.trim()
---

<article class="indicador flex flex-col gap-3 border-t-2 border-rule-strong pt-4" aria-labelledby={`ind-${ind.id}`}>
  <h2 id={`ind-${ind.id}`} class="font-sans text-base font-bold text-ink">{ind.nombre}</h2>
  <p class="num font-serif text-5xl leading-none text-ink">{formatear(ind.valor, ind.formato)}</p>
  <div class="flex items-center justify-between gap-3">
    {textoCambio && <p class:list={["text-base font-bold", `tono-${tono}`]}>{textoCambio}</p>}
    {
      spark && (
        <svg width={spark.ancho} height={spark.alto} viewBox={`-2 -2 ${spark.ancho + 4} ${spark.alto + 4}`} class="text-accent" aria-hidden="true">
          <path d={spark.d} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <circle cx={spark.ultimo[0]} cy={spark.ultimo[1]} r="3" fill="currentColor" />
        </svg>
      )
    }
  </div>
  <p class="text-base text-ink-2">{ind.explicacion}</p>
  <p class="text-sm text-ink-3">
    {ind.periodo} · <a href={ind.fuente.url} rel="noopener" class="underline">{ind.fuente.nombre}</a>
  </p>
</article>

<style>
  .tono-bueno {
    color: var(--accent);
  }
  .tono-malo {
    color: var(--nivel-baja);
  }
  .tono-neutro {
    color: var(--ink-2);
  }
</style>
