---
/**
 * Nota al margen para acompañar un gráfico o un párrafo en MDX, como una "observación" del formulario.
 *
 * Uso: <Anotacion titulo="Diciembre 2024">El aguinaldo aumenta la demanda de dólares.</Anotacion>
 */
interface Props {
  titulo?: string
}
const { titulo = "Observación" } = Astro.props
---

<aside class="anotacion my-6 max-w-md border-[1.5px] border-dashed border-forma-fuerte px-4 py-3 text-base text-tinta-2">
  <p class="etiqueta mb-1">{titulo}</p>
  <div><slot /></div>
</aside>
