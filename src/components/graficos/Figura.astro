---
/**
 * Envoltorio común de los gráficos:
 * título-conclusión, SVG (versión ancha y angosta), resumen accesible, tabla de datos plegable y fuente.
 */
import Fuente from "./Fuente.astro"
import ChevronDown from "@/components/icons/ChevronDown.astro"
import type { Variante } from "@/lib/graficos"

interface Props {
  titulo: string
  resumen: string
  fuente: { nombre: string; url: string }
  actualizado?: Date
  variantes: Variante[]
  tabla: { columnas: string[]; filas: (string | number)[][] }
  /** Nivel del título (h2 para el gráfico principal, h3 dentro de la capa técnica). */
  nivel?: 2 | 3
  ficticio?: boolean
}

const { titulo, resumen, fuente, actualizado, variantes, tabla, nivel = 3, ficticio = false } = Astro.props
const id = `g-${Math.random().toString(36).slice(2, 8)}`
const [ancha, angosta] = variantes
const H = `h${nivel}` as "h2" | "h3"
---

<figure class="grafico" aria-labelledby={`${id}-t`} aria-describedby={`${id}-r`}>
  <H id={`${id}-t`} class:list={["titulo mb-1 font-serif text-ink", nivel === 2 ? "text-[1.75rem] sm:text-[2.1rem]" : "text-2xl"]}>
    {titulo}
  </H>
  {ficticio && <p class="ficticio mb-3 inline-block rounded px-2 py-0.5 text-sm font-bold">Datos ficticios de muestra</p>}
  <p id={`${id}-r`} class="sr-only">{resumen}</p>
  <div class="lienzo mt-4" aria-hidden="true">
    {ancha && <div class="ancha" set:html={ancha.svg} />}
    {angosta && <div class="angosta" set:html={angosta.svg} />}
  </div>
  <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <Fuente nombre={fuente.nombre} url={fuente.url} actualizado={actualizado} />
    <details class="tabla-datos group w-full sm:w-auto">
      <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-sm text-ink-2 hover:text-ink">
        Ver los datos en tabla
        <ChevronDown class="size-4 transition-transform group-open:rotate-180" />
      </summary>
      <div class="mt-3 max-h-80 overflow-auto rounded-md border border-rule">
        <table class="num w-full text-sm">
          <caption class="sr-only">{titulo}</caption>
          <thead class="sticky top-0 bg-paper-2">
            <tr>{tabla.columnas.map((c) => <th scope="col" class="px-3 py-2 text-left font-bold">{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              tabla.filas.map((f) => (
                <tr class="border-t border-rule">
                  {f.map((v, i) => (i === 0 ? <th scope="row" class="px-3 py-1.5 text-left font-normal">{v}</th> : <td class="px-3 py-1.5 text-right">{v}</td>))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </figcaption>
</figure>

<style>
  .grafico {
    container-type: inline-size;
  }
  .lienzo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .angosta {
    display: none;
  }
  @container (max-width: 34rem) {
    .ancha {
      display: none;
    }
    .angosta {
      display: block;
    }
  }
  .ficticio {
    background: color-mix(in oklab, var(--nivel-media) 16%, transparent);
    color: var(--nivel-media);
  }
  .tabla-datos[open] {
    flex-basis: 100%;
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
