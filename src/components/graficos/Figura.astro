---
/**
 * Envoltorio de los gráficos como campo del formulario:
 * título-conclusión, SVG (versión ancha y angosta), resumen accesible, fuente "cosida" al gráfico
 * y tabla de datos plegable.
 */
import Fuente from "./Fuente.astro"
import type { Variante } from "@/lib/graficos"

interface Props {
  titulo: string
  resumen: string
  fuente: { nombre: string; url: string }
  actualizado?: Date
  variantes: Variante[]
  tabla: { columnas: string[]; filas: (string | number)[][] }
  /** Nivel del título (h2 para el gráfico principal, h3 dentro de la capa técnica). */
  nivel?: 2 | 3
  ficticio?: boolean
}

const { titulo, resumen, fuente, actualizado, variantes, tabla, nivel = 3, ficticio = false } = Astro.props
const id = `g-${Math.random().toString(36).slice(2, 8)}`
const [ancha, angosta] = variantes
const H = `h${nivel}` as "h2" | "h3"
---

<figure class="grafico" aria-labelledby={`${id}-t`} aria-describedby={`${id}-r`}>
  <H id={`${id}-t`} class:list={["titulo", nivel === 2 ? "t2" : "t3"]}>{titulo}</H>
  <p id={`${id}-r`} class="sr-only">{resumen}</p>
  <div class="marco">
    {ficticio && <p class="ficticio">Datos ficticios de muestra</p>}
    <div class="lienzo" aria-hidden="true">
      {ancha && <div class="ancha" set:html={ancha.svg} />}
      {angosta && <div class="angosta" set:html={angosta.svg} />}
    </div>
    <figcaption class="pie">
      <Fuente nombre={fuente.nombre} url={fuente.url} actualizado={actualizado} />
      <details class="tabla-datos">
        <summary>Ver los datos en tabla</summary>
        <div class="mt-3 max-h-80 overflow-auto border border-forma">
          <table class="w-full text-sm" style="font-variant-numeric: tabular-nums">
            <caption class="sr-only">{titulo}</caption>
            <thead class="sticky top-0 bg-forma-f">
              <tr>{tabla.columnas.map((c) => <th scope="col" class="px-3 py-2 text-left font-bold">{c}</th>)}</tr>
            </thead>
            <tbody>
              {
                tabla.filas.map((f) => (
                  <tr class="border-t border-forma">
                    {f.map((v, i) => (i === 0 ? <th scope="row" class="px-3 py-1.5 text-left font-normal">{v}</th> : <td class="px-3 py-1.5 text-right">{v}</td>))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </figcaption>
  </div>
</figure>

<style>
  .grafico {
    container-type: inline-size;
  }
  .t2 {
    font-size: clamp(1.6rem, 1.2rem + 1.3vw, 2.2rem);
    max-width: 30ch;
  }
  .t3 {
    font-size: 1.35rem;
  }
  .marco {
    margin-top: 0.85rem;
    border: 2px solid var(--forma);
    padding: 1rem 1rem 0;
  }
  .lienzo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .angosta {
    display: none;
  }
  @container (max-width: 34rem) {
    .ancha {
      display: none;
    }
    .angosta {
      display: block;
    }
    .marco {
      padding: 0.75rem 0.6rem 0;
    }
  }
  .ficticio {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0 0.45rem;
    border: 1.5px solid var(--nivel-media);
    color: var(--nivel-media);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin: 0.75rem -1rem 0;
    padding: 0.6rem 1rem 0.7rem;
    border-top: 1px solid var(--forma);
    background: var(--forma-f);
  }
  @container (max-width: 34rem) {
    .pie {
      margin-inline: -0.6rem;
      padding-inline: 0.6rem;
    }
  }
  .tabla-datos summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--pluma);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .tabla-datos[open] {
    flex-basis: 100%;
  }
</style>
