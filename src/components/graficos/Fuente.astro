---
interface Props {
  nombre: string
  url: string
  actualizado?: Date
}
import { fecha } from "@/lib/formato"
const { nombre, url, actualizado } = Astro.props
---

<p class="fuente text-sm leading-snug text-tinta-2">
  <span class="font-semibold text-forma-t">Fuente:</span>{" "}
  <a href={url} rel="noopener" class="underline decoration-forma-fuerte underline-offset-3 hover:text-tinta">{nombre}</a>{actualizado && <span>. Datos al {fecha(actualizado)}</span>}.
</p>
