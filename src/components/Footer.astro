---
import { PERFIL, esPendiente } from "@/data/perfil"
const anio = new Date().getFullYear()

const enlaces = [
  { texto: "LinkedIn", url: PERFIL.enlaces.linkedin },
  { texto: "GitHub", url: PERFIL.enlaces.github },
  { texto: "RSS de casos", url: "/rss.xml" },
].filter((e) => !esPendiente(e.url))
---

<footer class="pie mt-24">
  <div class="contenedor grid gap-8 py-10 text-base text-tinta-2 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <p class="nombre text-tinta">{PERFIL.nombre}</p>
      <p>{PERFIL.lugar}</p>
      <p class="mt-2 text-sm">© {anio}. Los datos vienen de fuentes públicas citadas en cada caso.</p>
    </div>
    <div class="flex flex-col gap-3 md:items-end">
      {
        enlaces.length > 0 && (
          <ul class="flex flex-wrap gap-x-5 gap-y-1">
            {enlaces.map((e) => (
              <li>
                <a href={e.url} class="underline decoration-forma-fuerte hover:text-tinta">
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="text-sm">
        Diseño basado en <a href="https://github.com/midudev/porfolio.dev" class="underline hover:text-tinta" rel="noopener">porfolio.dev de midudev</a>, con licencia <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.es" class="underline hover:text-tinta" rel="license noopener">CC BY-NC 4.0</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .pie {
    border-top: 2px solid var(--forma);
  }
  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.15rem;
  }
</style>
