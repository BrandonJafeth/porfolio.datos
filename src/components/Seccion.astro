---
/** Sección del inicio: título grande, nota opcional en tinta de formulario y acción a la derecha. */
interface Props {
  id: string
  titulo: string
  nota?: string
  accion?: { texto: string; url: string }
  class?: string
}
const { id, titulo, nota, accion, class: clase } = Astro.props
---

<section id={id} aria-labelledby={`${id}-t`} class:list={["contenedor scroll-mt-6 pt-20 sm:pt-28", clase]}>
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 sm:mb-8">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 id={`${id}-t`} class="text-[2rem] sm:text-[2.6rem]">{titulo}</h2>
      {nota && <p class="text-base font-semibold text-forma-t">{nota}</p>}
    </div>
    {
      accion && (
        <a href={accion.url} class="text-base font-bold text-pluma underline decoration-2 underline-offset-4">
          {accion.texto}
        </a>
      )
    }
  </div>
  <slot />
</section>
