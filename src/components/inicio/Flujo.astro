---
/** Cómo trabajo: 6 pasos en orden. Sin celdas: número en casilla + nombre + detalle. */
import { FLUJO } from "@/data/perfil"
---

<ol class="flujo" aria-label="Flujo de trabajo en 6 pasos">
  {
    FLUJO.map((f, i) => (
      <li class="paso">
        <span class="casillas" aria-hidden="true">
          <span>{i + 1}</span>
        </span>
        <span class="texto">
          <span class="sr-only">Paso {i + 1}: </span>
          <span class="nombre">{f.paso}</span>
          <span class="detalle">{f.detalle}</span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .flujo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--forma);
  }
  .paso {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--forma);
  }
  .texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 108%;
    font-weight: 750;
    font-size: 1.12rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .detalle {
    font-size: 1rem;
    color: var(--tinta-2);
  }
  @media (min-width: 48rem) {
    .flujo {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (min-width: 72rem) {
    .flujo {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    .paso {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
      border-bottom: 0;
      padding-block: 1rem 0;
    }
    .casillas {
      justify-self: start;
    }
  }
</style>
