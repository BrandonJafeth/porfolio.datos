---
/** Cómo trabajo: 6 pasos en orden, como una fila de campos numerados del formulario. */
import { FLUJO } from "@/data/perfil"
---

<ol class="flujo" aria-label="Flujo de trabajo en 6 pasos">
  {
    FLUJO.map((f, i) => (
      <li class="paso">
        <span class="casillas" aria-hidden="true">
          <span>{i + 1}</span>
        </span>
        <span class="sr-only">Paso {i + 1}: </span>
        <span class="nombre">{f.paso}</span>
        <span class="detalle">{f.detalle}</span>
      </li>
    ))
  }
</ol>

<style>
  .flujo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 2px solid var(--forma);
  }
  .paso {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 1rem 1rem;
    border-right: 1px solid var(--forma);
    border-bottom: 1px solid var(--forma);
  }
  .paso:nth-child(2n) {
    border-right: 0;
  }
  .paso:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .casillas {
    grid-row: span 2;
  }
  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .detalle {
    font-size: 1rem;
    color: var(--tinta-2);
  }
  @media (min-width: 64rem) {
    .flujo {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .paso {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.5rem;
      border-bottom: 0;
      border-right: 1px solid var(--forma) !important;
    }
    .paso:last-child {
      border-right: 0 !important;
    }
    .casillas {
      grid-row: auto;
      justify-self: start;
    }
  }
</style>
