---
import { FLUJO } from "@/data/perfil"
---

<ol class="flujo grid gap-0 sm:grid-cols-3 lg:grid-cols-6" aria-label="Flujo de trabajo en 6 pasos">
  {
    FLUJO.map((f, i) => (
      <li class="paso relative pb-7 pl-8 sm:pb-8 sm:pl-0 sm:pr-4 sm:pt-8" style={`--i:${i}`}>
        <span class="nodo" aria-hidden="true" />
        <span class="num block text-sm text-ink-3">Paso {i + 1}</span>
        <span class="block font-serif text-xl leading-tight text-ink sm:text-[1.35rem]">{f.paso}</span>
        <span class="mt-1 block text-base text-ink-2">{f.detalle}</span>
      </li>
    ))
  }
</ol>

<style>
  .paso::before {
    content: "";
    position: absolute;
    background: var(--rule);
    /* móvil: línea vertical */
    left: 0.4rem;
    top: 0.5rem;
    bottom: -0.5rem;
    width: 2px;
  }
  .paso:last-child::before {
    display: none;
  }
  .nodo {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--accent);
  }
  .paso:last-child .nodo {
    background: var(--accent);
  }
  @media (min-width: 40rem) {
    .paso::before {
      left: 0.45rem;
      right: 0;
      top: 0.4rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .paso:nth-child(3n)::before {
      display: none;
    }
    .nodo {
      top: 0;
    }
  }
  @media (min-width: 64rem) {
    .paso:nth-child(3n)::before {
      display: block;
    }
    .paso:last-child::before {
      display: none;
    }
  }
</style>
