---
/** Indicador discreto de la ruta: semana actual en casillas + enlace a /ruta. */
import { resumenRuta, ruta } from "@/lib/ruta"
import { fecha } from "@/lib/formato"
import { t } from "@/i18n"

const r = resumenRuta()
const digitos = String(Math.min(Math.max(r.actual, 0), r.total)).padStart(2, "0").split("")
const texto = !r.empezo
  ? t("ruta.empieza", { fecha: fecha(ruta.inicio) })
  : r.termino
    ? t("ruta.terminada", { total: r.total })
    : r.enColchon
      ? t("ruta.colchon", { semana: r.actual, total: r.total })
      : t("ruta.enProgreso", { semana: r.actual, total: r.total })
---

<p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-base">
  {
    r.empezo && (
      <span class="casillas" aria-hidden="true">
        {digitos.map((d) => (
          <span>{d}</span>
        ))}
      </span>
    )
  }
  <span>{texto}.</span>
  <a href="/ruta/" class="font-bold text-pluma underline decoration-2 underline-offset-4">{t("ruta.ver")}</a>
</p>
