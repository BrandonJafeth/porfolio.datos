---
/**
 * Hero minimalista. Sin cajas: una sola línea de lectura.
 * 1. Nombre (pequeño) → 2. Rol (H1, SEO) → 3. Promesa escrita en azul pluma sobre renglones de formulario
 * → 4. Herramientas → 5. Acciones → 6. Ruta en una línea.
 * Los "renglones" son la única huella del mundo Boleta aquí: la respuesta escrita sobre líneas impresas.
 */
import { PERFIL, esPendiente } from "@/data/perfil"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import Mail from "@/components/icons/Mail.astro"
import IndicadorRuta from "./IndicadorRuta.astro"
import { t } from "@/i18n"

const { linkedin, github, cv, email } = PERFIL.enlaces
const enlacesTexto = [
  { texto: "GitHub", url: github },
  { texto: "CV", url: cv },
  { texto: "Ver casos", url: "/casos/" },
].filter((e) => !esPendiente(e.url))
---

<section class="hero contenedor" aria-labelledby="hero-t">
  <p class="nombre">{PERFIL.nombre}</p>
  <h1 id="hero-t" class="rol">{t("hero.h1")}</h1>

  <p class="promesa escribir">{t("hero.promesa")}</p>

  <p class="apoyo">{t("hero.apoyo")}</p>

  <div class="acciones">
    {
      !esPendiente(linkedin) && (
        <a href={linkedin} rel="noopener" class="boton boton-lleno">
          <LinkedIn class="size-5" /> LinkedIn
        </a>
      )
    }
    {
      !esPendiente(email) && (
        <a href={`mailto:${email}`} class="boton">
          <Mail class="size-5" /> Escribime
        </a>
      )
    }
    <ul class="enlaces">
      {
        enlacesTexto.map((e) => (
          <li>
            <a href={e.url} rel={e.url.startsWith("http") ? "noopener" : undefined}>
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ruta">
    <IndicadorRuta />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 6.5rem);
  }
  .nombre {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--tinta-2);
  }
  .rol {
    margin-top: 0.3rem;
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 2rem);
    font-stretch: 112%;
    font-weight: 780;
    line-height: 1.15;
  }
  /* La respuesta escrita en pluma sobre renglones impresos en tinta de formulario. */
  .promesa {
    --renglon: 1.1em;
    margin-top: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
    max-width: 14ch;
    font-family: var(--font-titulo);
    font-stretch: 100%;
    font-weight: 760;
    font-size: clamp(2.5rem, 1.3rem + 5.2vw, 5.4rem);
    line-height: var(--renglon);
    letter-spacing: -0.032em;
    color: var(--pluma);
    text-wrap: balance;
    background-image: linear-gradient(transparent calc(100% - 2px), var(--forma) calc(100% - 2px));
    background-size: 100% var(--renglon);
    background-position: 0 0;
    background-repeat: repeat-y;
  }
  .apoyo {
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--tinta-2);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .enlaces a {
    font-weight: 700;
    color: var(--pluma);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .ruta {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--forma);
    max-width: 40rem;
  }
</style>
