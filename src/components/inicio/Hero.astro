---
/**
 * Hero como FICHA de la boleta, pensado para quien decide en 5 segundos (reclutador, cliente):
 * 1. Quién: foto + nombre grande + rol (H1 para SEO) + lugar.
 * 2. Cómo contactarlo: LinkedIn, correo, CV y GitHub, en la misma ficha.
 * 3. Qué hace: la promesa "escrita" en azul pluma.
 * 4. Pruebas: herramientas, certificaciones verificables y ruta en curso.
 * La foto se "imprime" sobre el papel del formulario (escala de grises fundida con el campo).
 */
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import { PERFIL, CERTIFICACIONES, esPendiente } from "@/data/perfil"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import GitHub from "@/components/icons/GitHub.astro"
import FileText from "@/components/icons/FileText.astro"
import Mail from "@/components/icons/Mail.astro"
import MapPin from "@/components/icons/MapPin.astro"
import IndicadorRuta from "./IndicadorRuta.astro"
import { t } from "@/i18n"

// Foto: src/assets/foto.(avif|jpg|png|webp). Se detecta sola.
const fotos = import.meta.glob<ImageMetadata>("/src/assets/foto.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default",
})
const foto = Object.values(fotos)[0]

const { linkedin, github, cv, email } = PERFIL.enlaces
const botones = [
  { texto: "LinkedIn", url: linkedin, Icono: LinkedIn, lleno: true },
  { texto: "Escribime", url: esPendiente(email) ? email : `mailto:${email}`, Icono: Mail, lleno: false },
  { texto: "CV", url: cv, Icono: FileText, lleno: false },
  { texto: "GitHub", url: github, Icono: GitHub, lleno: false },
]
const dev = import.meta.env.DEV
const verificables = CERTIFICACIONES.filter((c) => c.verificar).length
---

<section class="contenedor pt-8 sm:pt-12" aria-labelledby="hero-t">
  <div class="boleta">
    <div class="ficha">
      <div class="retrato">
        {
          foto ? (
            <Image
              src={foto}
              alt={`Foto de ${PERFIL.nombre}`}
              width={560}
              height={700}
              widths={[240, 400, 560]}
              sizes="(min-width: 64rem) 17rem, (min-width: 48rem) 13rem, 7rem"
              loading="eager"
              fetchpriority="high"
              class="foto"
            />
          ) : (
            <div class="foto foto-vacia" role="img" aria-label={`Iniciales de ${PERFIL.nombre}`}>
              <span>BC</span>
            </div>
          )
        }
      </div>

      <div class="datos">
        <p class="nombre">{PERFIL.nombre}</p>
        <h1 id="hero-t" class="rol">{t("hero.h1")}</h1>
        <p class="lugar">
          <MapPin class="size-5 shrink-0 text-forma-t" />
          {PERFIL.ciudad}, {PERFIL.provincia}
        </p>
      </div>
      <ul class="acciones">
          {
            botones.map(({ texto, url, Icono, lleno }) =>
              !esPendiente(url) ? (
                <li>
                  <a href={url} rel="noopener" class:list={["boton", lleno && "boton-lleno"]}>
                    <Icono class="size-5" /> {texto}
                  </a>
                </li>
              ) : dev ? (
                <li>
                  <span class="boton pendiente" title={`Falta ${url} en src/data/perfil.ts`}>
                    <Icono class="size-5" /> {texto}: {url}
                  </span>
                </li>
              ) : null,
            )
          }
          <li>
            <a href="/casos/" class="boton">{t("hero.verCasos")}</a>
          </li>
        </ul>
    </div>

    <div class="campo-f c-promesa">
      <span class="etiqueta">¿Qué hace?</span>
      <p class="promesa escribir">{t("hero.promesa")}</p>
    </div>

    <div class="pruebas">
      <div class="campo-f">
        <span class="etiqueta">Herramientas y temas</span>
        <p class="text-base text-tinta-2 sm:text-lg">{t("hero.apoyo")}</p>
      </div>
      <div class="campo-f">
        <span class="etiqueta">Certificaciones</span>
        <p class="text-base sm:text-lg">
          <span class="num text-2xl font-extrabold text-pluma">{verificables}</span> verificables en línea, entre ellas Data Analytics Essentials de Cisco.
        </p>
        <a href="#formacion" class="mt-1 inline-block font-bold text-pluma underline decoration-2 underline-offset-4">Ver certificaciones</a>
      </div>
      <div class="campo-f">
        <span class="etiqueta">Ruta de datos</span>
        <IndicadorRuta />
      </div>
    </div>
  </div>
</section>

<style>
  /* Las líneas internas son el "gap" de 1px sobre fondo de tinta de formulario. */
  .boleta {
    display: grid;
    gap: 1px;
    background: var(--forma);
    border: 2px solid var(--forma);
  }
  .campo-f {
    background: var(--papel);
    padding: 0.85rem 1rem 1rem;
    min-width: 0;
  }
  .campo-f .etiqueta {
    margin-bottom: 0.35rem;
  }

  /* ── Ficha: foto + identidad + contacto ── */
  .ficha {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 1rem;
    background: var(--forma-f);
  }
  .retrato {
    align-self: start;
  }
  .foto {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1.5px solid var(--forma-fuerte);
    /* "Impresa" en el papel: escala de grises fundida con el relleno del campo. */
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }
  :global(:root[data-theme="dark"]) .foto {
    mix-blend-mode: normal;
    filter: grayscale(1) contrast(1.05) brightness(0.92);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .foto {
      mix-blend-mode: normal;
      filter: grayscale(1) contrast(1.05) brightness(0.92);
    }
  }
  .foto-vacia {
    display: grid;
    place-items: center;
    background: var(--papel);
    color: var(--forma-t);
    font-family: var(--font-titulo);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2rem;
  }
  .datos {
    min-width: 0;
  }
  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 118%;
    font-weight: 820;
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3.3rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .rol {
    margin-top: 0.45rem;
    font-size: clamp(1.1rem, 0.95rem + 0.8vw, 1.6rem);
    font-stretch: 105%;
    font-weight: 700;
    color: var(--tinta-2);
    letter-spacing: -0.01em;
  }
  .lugar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--tinta-2);
  }
  .acciones {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .acciones .boton {
    background: var(--papel);
  }
  .acciones .boton-lleno {
    background: var(--tinta);
  }
  .acciones .boton:hover {
    background: var(--tinta);
  }
  .acciones .boton-lleno:hover {
    background: var(--pluma);
  }
  .pendiente {
    border-style: dashed;
    color: var(--nivel-media);
    border-color: var(--nivel-media);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  /* ── Promesa ── */
  .promesa {
    font-family: var(--font-titulo);
    font-stretch: 100%;
    font-weight: 760;
    font-size: clamp(2.2rem, 1.3rem + 4vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.032em;
    color: var(--pluma);
    max-width: 17ch;
    text-wrap: balance;
    padding-block: 0.4rem 0.3rem;
  }

  /* ── Pruebas ── */
  .pruebas {
    display: grid;
    gap: 1px;
    background: var(--forma);
  }

  @media (min-width: 48rem) {
    .ficha {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 0 1.5rem;
      padding: 1.25rem;
    }
    .retrato {
      grid-row: 1 / span 2;
    }
    .datos {
      align-self: end;
    }
    .acciones {
      grid-column: 2;
      align-self: start;
    }
    .c-promesa {
      padding-block: 1.3rem 1.5rem;
    }
    .pruebas {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .ficha {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 0 2rem;
      padding: 1.5rem;
    }
  }
</style>
