---
/**
 * Hero como boleta llenada: cada dato es un campo del formulario.
 * La promesa es la "respuesta escrita" en azul de bolígrafo.
 */
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import { PERFIL, esPendiente } from "@/data/perfil"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import GitHub from "@/components/icons/GitHub.astro"
import FileText from "@/components/icons/FileText.astro"
import IndicadorRuta from "./IndicadorRuta.astro"
import { t } from "@/i18n"

// TODO_FOTO: colocá tu foto como src/assets/foto.jpg (o .png / .webp). Se detecta sola.
const fotos = import.meta.glob<ImageMetadata>("/src/assets/foto.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default",
})
const foto = Object.values(fotos)[0]

const botones = [
  { texto: "LinkedIn", url: PERFIL.enlaces.linkedin, Icono: LinkedIn, lleno: true },
  { texto: "GitHub", url: PERFIL.enlaces.github, Icono: GitHub, lleno: false },
  { texto: "CV", url: PERFIL.enlaces.cv, Icono: FileText, lleno: false },
]
const dev = import.meta.env.DEV
---

<section class="contenedor pt-8 sm:pt-12" aria-labelledby="hero-t">
  <div class="boleta">
    <div class="campo-f c-ocupacion">
      <span class="etiqueta">Ocupación</span>
      <h1 id="hero-t" class="ocupacion">{t("hero.h1")}</h1>
    </div>
    <div class="campo-f c-lugar">
      <span class="etiqueta">Lugar</span>
      <p class="lugar">{PERFIL.ciudad}, {PERFIL.provincia}</p>
    </div>
    <div class="campo-f c-promesa">
      <span class="etiqueta">¿Qué hace?</span>
      <p class="promesa escribir">{t("hero.promesa")}</p>
    </div>
    <div class="campo-f c-foto">
      <span class="etiqueta">Fotografía</span>
      {
        foto ? (
          <Image
            src={foto}
            alt={`Foto de ${PERFIL.nombre}`}
            width={480}
            height={600}
            widths={[240, 480]}
            sizes="(min-width: 64rem) 15rem, 40vw"
            loading="eager"
            fetchpriority="high"
            class="foto"
          />
        ) : (
          <div class="foto foto-vacia" role="img" aria-label={`Iniciales de ${PERFIL.nombre}`}>
            <span>BC</span>
          </div>
        )
      }
    </div>
    <div class="campo-f c-temas">
      <span class="etiqueta">Herramientas y temas</span>
      <p class="medida text-lg text-tinta-2">{t("hero.apoyo")}</p>
    </div>
    <div class="campo-f c-ruta">
      <span class="etiqueta">Ruta de datos</span>
      <IndicadorRuta />
    </div>
  </div>

  <ul class="mt-5 flex flex-wrap gap-3">
    {
      botones.map(({ texto, url, Icono, lleno }) =>
        !esPendiente(url) ? (
          <li>
            <a href={url} rel="noopener" class:list={["boton", lleno && "boton-lleno"]}>
              <Icono class="size-5" /> {texto}
            </a>
          </li>
        ) : dev ? (
          <li>
            <span class="boton pendiente" title={`Falta ${url} en src/data/perfil.ts`}>
              <Icono class="size-5" /> {texto}: {url}
            </span>
          </li>
        ) : null,
      )
    }
    <li>
      <a href="/casos/" class="boton">{t("hero.verCasos")}</a>
    </li>
  </ul>
</section>

<style>
  .boleta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 2px solid var(--forma);
    background: var(--papel);
  }
  .campo-f {
    padding: 0.85rem 1rem 1rem;
    border-bottom: 1px solid var(--forma);
    min-width: 0;
  }
  .campo-f .etiqueta {
    margin-bottom: 0.35rem;
  }
  .ocupacion {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem);
  }
  .lugar {
    font-family: var(--font-titulo);
    font-stretch: 112%;
    font-weight: 720;
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .promesa {
    font-family: var(--font-titulo);
    font-stretch: 100%;
    font-weight: 760;
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.032em;
    color: var(--pluma);
    max-width: 15ch;
    text-wrap: balance;
    padding-block: 0.5rem 0.4rem;
  }
  .foto {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-width: 100%;
    object-fit: cover;
    border: 1px solid var(--forma);
  }
  .foto-vacia {
    display: grid;
    place-items: center;
    background: var(--forma-f);
    color: var(--forma-t);
    font-family: var(--font-titulo);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.6rem;
  }
  .c-foto {
    display: none;
  }
  .c-ruta {
    border-bottom: 0;
  }
  .pendiente {
    border-style: dashed;
    color: var(--nivel-media);
    border-color: var(--nivel-media);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  @media (min-width: 48rem) {
    .boleta {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
    .campo-f {
      border-right: 1px solid var(--forma);
    }
    .c-lugar,
    .c-ruta {
      border-right: 0;
    }
    .c-promesa {
      grid-column: 1 / -1;
      border-right: 0;
      padding-block: 1.4rem 1.6rem;
    }
    .c-temas {
      border-bottom: 0;
    }
  }
  @media (min-width: 64rem) {
    .boleta {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr) 15rem;
    }
    .c-ocupacion {
      grid-column: 1;
    }
    .c-lugar {
      grid-column: 2;
      border-right: 1px solid var(--forma);
    }
    .c-foto {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 3;
      border-right: 0;
      border-bottom: 0;
    }
    .c-promesa {
      grid-column: 1 / span 2;
      border-right: 1px solid var(--forma);
    }
    .c-temas {
      grid-column: 1;
    }
    .c-ruta {
      grid-column: 2;
      border-right: 1px solid var(--forma);
    }
  }
</style>
