---
/**
 * Hero (sin foto), organizado como una boleta con dos columnas:
 * - Izquierda, protagonista: la promesa "escrita" en azul pluma + herramientas y temas.
 * - Derecha, la ficha: nombre, ocupación (H1 para SEO), lugar y contacto.
 * - Abajo: pruebas (certificaciones verificables, ruta en curso) y acceso a los casos.
 * En móvil la ficha va primero: quien llega sabe en 5 segundos quién es y cómo contactarlo.
 */
import { PERFIL, CERTIFICACIONES, esPendiente } from "@/data/perfil"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import GitHub from "@/components/icons/GitHub.astro"
import FileText from "@/components/icons/FileText.astro"
import Mail from "@/components/icons/Mail.astro"
import IndicadorRuta from "./IndicadorRuta.astro"
import { t } from "@/i18n"

const { linkedin, github, cv, email } = PERFIL.enlaces
const contacto = [
  { texto: "LinkedIn", url: linkedin, Icono: LinkedIn, lleno: true },
  { texto: "Escribime", url: esPendiente(email) ? email : `mailto:${email}`, Icono: Mail, lleno: false },
  { texto: "CV", url: cv, Icono: FileText, lleno: false },
  { texto: "GitHub", url: github, Icono: GitHub, lleno: false },
]
const dev = import.meta.env.DEV
const verificables = CERTIFICACIONES.filter((c) => c.verificar).length
---

<section class="contenedor pt-8 sm:pt-12" aria-labelledby="hero-t">
  <div class="boleta">
    <div class="campo-f c-ficha">
      <span class="etiqueta">Nombre</span>
      <p class="nombre">{PERFIL.nombre}</p>
      <span class="etiqueta mt-4">Ocupación</span>
      <h1 id="hero-t" class="rol">{t("hero.h1")}</h1>
      <span class="etiqueta mt-4">Lugar</span>
      <p class="lugar">{PERFIL.ciudad}, {PERFIL.provincia}</p>
    </div>

    <div class="campo-f c-promesa">
      <span class="etiqueta">¿Qué hace?</span>
      <p class="promesa escribir">{t("hero.promesa")}</p>
      <p class="apoyo">{t("hero.apoyo")}</p>
    </div>

    <div class="campo-f c-contacto">
      <span class="etiqueta">Contacto</span>
      <ul class="acciones">
        {
          contacto.map(({ texto, url, Icono, lleno }) =>
            !esPendiente(url) ? (
              <li>
                <a href={url} rel="noopener" class:list={["boton", lleno && "boton-lleno"]}>
                  <Icono class="size-5" /> {texto}
                </a>
              </li>
            ) : dev ? (
              <li>
                <span class="boton pendiente" title={`Falta ${url} en src/data/perfil.ts`}>
                  <Icono class="size-5" /> {texto}: {url}
                </span>
              </li>
            ) : null,
          )
        }
      </ul>
    </div>

    <div class="campo-f c-certs">
      <span class="etiqueta">Certificaciones</span>
      <p class="text-base sm:text-lg">
        <span class="num text-2xl font-extrabold text-pluma">{verificables}</span> verificables en línea, entre ellas Data Analytics Essentials de Cisco.
      </p>
      <a href="#formacion" class="mt-1 inline-block font-bold text-pluma underline decoration-2 underline-offset-4">Ver certificaciones</a>
    </div>

    <div class="campo-f c-ruta">
      <span class="etiqueta">Ruta de datos</span>
      <IndicadorRuta />
    </div>

    <a href="/casos/" class="c-casos">
      <span class="etiqueta">Casos</span>
      <span class="ir">{t("hero.verCasos")}</span>
      <span class="text-base text-tinta-2">Preguntas reales respondidas con datos.</span>
    </a>
  </div>
</section>

<style>
  /* Las líneas internas son el "gap" de 1px sobre la tinta de formulario. */
  .boleta {
    display: grid;
    gap: 1px;
    background: var(--forma);
    border: 2px solid var(--forma);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "ficha"
      "contacto"
      "promesa"
      "certs"
      "ruta"
      "casos";
  }
  .campo-f,
  .c-casos {
    background: var(--papel);
    padding: 0.9rem 1rem 1rem;
    min-width: 0;
  }
  .campo-f .etiqueta,
  .c-casos .etiqueta {
    margin-bottom: 0.3rem;
  }
  .c-ficha {
    grid-area: ficha;
    background: var(--forma-f);
  }
  .c-promesa {
    grid-area: promesa;
  }
  .c-contacto {
    grid-area: contacto;
    background: var(--forma-f);
  }
  .c-certs {
    grid-area: certs;
  }
  .c-ruta {
    grid-area: ruta;
  }
  .c-casos {
    grid-area: casos;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    transition: background 160ms var(--ease-salida);
  }
  .c-casos:hover {
    background: var(--pluma-f);
  }
  .ir {
    font-family: var(--font-titulo);
    font-stretch: 112%;
    font-weight: 780;
    font-size: 1.4rem;
    line-height: 1.1;
    color: var(--pluma);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 118%;
    font-weight: 820;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .rol {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-stretch: 105%;
    font-weight: 720;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .lugar {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .promesa {
    font-family: var(--font-titulo);
    font-stretch: 100%;
    font-weight: 760;
    font-size: clamp(2.3rem, 1.2rem + 4.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.032em;
    color: var(--pluma);
    max-width: 14ch;
    text-wrap: balance;
    padding-block: 0.35rem 0;
  }
  .apoyo {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: 1.1rem;
    color: var(--tinta-2);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .acciones .boton {
    background: var(--papel);
  }
  .acciones .boton-lleno,
  .acciones .boton:hover {
    background: var(--tinta);
  }
  .acciones .boton-lleno:hover {
    background: var(--pluma);
  }
  .pendiente {
    border-style: dashed;
    color: var(--nivel-media);
    border-color: var(--nivel-media);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  @media (min-width: 48rem) {
    .boleta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "promesa promesa"
        "ficha contacto"
        "certs ruta"
        "casos casos";
    }
    .c-promesa {
      padding: 1.4rem 1.4rem 1.6rem;
    }
  }
  @media (min-width: 64rem) {
    .boleta {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr) 21rem;
      grid-template-areas:
        "promesa promesa promesa ficha"
        "promesa promesa promesa contacto"
        "certs ruta casos casos";
    }
    .c-promesa {
      padding: 1.6rem 1.75rem 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .c-ficha,
    .c-contacto {
      padding: 1.1rem 1.25rem 1.2rem;
    }
    .acciones {
      flex-direction: column;
      align-items: stretch;
    }
    .acciones .boton {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
