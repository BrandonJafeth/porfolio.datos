---
/**
 * Confianza como pregunta del formulario con tres opciones; la elegida va marcada en azul pluma.
 * El texto dice el nivel y el motivo en palabras simples.
 */
import TextoGlosario from "./TextoGlosario.astro"
import { motivoConfianzaPorDefecto, textoConfianza } from "@/lib/casos"

interface Props {
  nivel: "alta" | "media" | "baja"
  motivo?: string
}
const { nivel, motivo = motivoConfianzaPorDefecto[nivel] } = Astro.props
const opciones = ["alta", "media", "baja"] as const
---

<div class="confianza">
  <ul class="opciones" aria-hidden="true">
    {
      opciones.map((o) => (
        <li class:list={["opcion", o === nivel && "marcada"]}>
          <span class="caja" />
          {o[0]!.toUpperCase() + o.slice(1)}
        </li>
      ))
    }
  </ul>
  <p class="medida mt-3 text-lg leading-snug">
    <strong class="font-bold">{textoConfianza[nivel]}.</strong>
    <TextoGlosario texto={motivo} />
  </p>
</div>

<style>
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .opcion {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--tinta-3);
  }
  .caja {
    width: 1.05rem;
    height: 1.05rem;
    border: 1.5px solid var(--forma-fuerte);
    position: relative;
  }
  .marcada {
    color: var(--pluma);
    font-weight: 700;
  }
  .marcada .caja {
    border-color: var(--pluma);
  }
  .marcada .caja::after {
    content: "";
    position: absolute;
    inset: 2.5px;
    background: var(--pluma);
  }
</style>
