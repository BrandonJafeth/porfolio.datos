---
/**
 * "Para curiosos: cómo lo hice" — capa técnica plegable (cerrada por defecto).
 * <details> nativo: accesible con teclado, funciona sin JS y Ctrl+F encuentra su contenido.
 */
import ChevronDown from "@/components/icons/ChevronDown.astro"
import GitHub from "@/components/icons/GitHub.astro"
import ExternalLink from "@/components/icons/ExternalLink.astro"
import TextoGlosario from "./TextoGlosario.astro"

interface Props {
  limitaciones: string[]
  fuentes: { nombre: string; url: string }[]
  repo: string
  herramientas: string[]
}
const { limitaciones, fuentes, repo, herramientas } = Astro.props
---

<details class="capa group border-y border-rule-strong" id="como-lo-hice">
  <summary class="flex cursor-pointer list-none items-center gap-4 py-5">
    <span class="flex-1">
      <span class="block font-serif text-2xl text-ink sm:text-[1.75rem]">Para curiosos: cómo lo hice</span>
      <span class="mt-1 block text-base text-ink-2">Método, código, limitaciones y fuentes · {herramientas.join(", ")}</span>
    </span>
    <span class="grid size-11 shrink-0 place-items-center rounded-full border border-rule text-ink-2 transition-colors group-hover:border-ink group-hover:text-ink">
      <ChevronDown class="size-5 transition-transform duration-300 group-open:rotate-180" />
    </span>
  </summary>

  <div class="pb-10 pt-2">
    <div class="prosa">
      <slot />
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <section aria-labelledby="limitaciones-t">
        <h3 id="limitaciones-t" class="font-serif text-xl">Limitaciones</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-ink-2 marker:text-ink-3">
          {limitaciones.map((l) => <li><TextoGlosario texto={l} /></li>)}
        </ul>
      </section>
      <section aria-labelledby="fuentes-t">
        <h3 id="fuentes-t" class="font-serif text-xl">Fuentes de datos</h3>
        <ul class="mt-3 space-y-2 text-base">
          {
            fuentes.map((f) => (
              <li>
                <a href={f.url} rel="noopener" class="inline-flex items-baseline gap-1.5 text-accent underline">
                  {f.nombre}
                  <ExternalLink class="size-3.5 self-center" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <a
      href={repo}
      rel="noopener"
      class="mt-10 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-base font-bold text-paper no-underline transition-transform hover:-translate-y-0.5"
    >
      <GitHub class="size-5" /> Ver el código en GitHub
    </a>
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .capa::details-content {
    transition:
      content-visibility 300ms allow-discrete,
      block-size 300ms var(--ease-salida);
    block-size: 0;
    overflow: clip;
  }
  .capa[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    .capa {
      interpolate-size: allow-keywords;
    }
  }
</style>
