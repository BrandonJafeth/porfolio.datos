---
/**
 * Fila de caso: un ítem del formulario. Número de pregunta, la pregunta, la respuesta en azul pluma
 * y el dato clave en su propio campo. Lo grande es la pregunta y la respuesta, no el título técnico.
 */
import { numeroDeCaso, textoPlano, urlCaso, type Caso } from "@/lib/casos"
import { cargarGrafico } from "@/lib/datos"
import { sparkline } from "@/lib/graficos"
import { fecha } from "@/lib/formato"
import { slugHerramienta } from "@/lib/herramientas"

interface Props {
  caso: Caso
  /** Encabezado: h2 en /casos, h3 dentro de secciones del inicio. */
  nivel?: 2 | 3
}

const { caso, nivel = 3 } = Astro.props
const { data } = caso
const n = await numeroDeCaso(caso.id)
const cifra = data.cifras[0]!
const grafico = cargarGrafico(caso.id, data.graficoPrincipal)
const serie =
  grafico.tipo === "linea" ? (grafico.series.find((s) => s.destacar) ?? grafico.series[0])?.puntos.map((p) => p.y) : undefined
const spark = serie ? sparkline(serie, 132, 34) : null
const H = `h${nivel}` as "h2" | "h3"
const tituloId = `caso-${caso.id}`
---

<article
  class="caso"
  data-herramientas={data.herramientas.map(slugHerramienta).join(" ")}
  data-tema={slugHerramienta(data.tema)}
  aria-labelledby={tituloId}
>
  <p class="numero num" aria-hidden="true">P{n}</p>
  <div class="cuerpo">
    <p class="meta">
      {data.tema}, <time datetime={data.fecha.toISOString()}>{fecha(data.fecha, "corto")}</time>
      {data.estado === "borrador" && <span class="borrador">Borrador</span>}
    </p>
    <H id={tituloId} class="pregunta" style={`view-transition-name: pregunta-${caso.id}`}>
      <a href={urlCaso(caso)} class="enlace-caso"><span class="sr-only">Pregunta {n}: </span>{data.pregunta}</a>
    </H>
    <p class="respuesta">{textoPlano(data.respuestaCorta)}</p>
    <p class="herramientas">Con {data.herramientas.join(", ")}</p>
  </div>
  <div class="dato">
    <span class="etiqueta">{cifra.etiqueta}</span>
    <p class="valor num">{cifra.valor}</p>
    {
      spark && (
        <svg class="spark" width={spark.ancho} height={spark.alto} viewBox={`-2 -2 ${spark.ancho + 4} ${spark.alto + 4}`} aria-hidden="true">
          <path d={spark.d} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          <rect x={spark.ultimo[0] - 3} y={spark.ultimo[1] - 3} width="6" height="6" fill="currentColor" />
        </svg>
      )
    }
  </div>
</article>

<style>
  .caso {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--forma);
  }
  .numero {
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--forma-t);
  }
  .meta {
    font-size: 0.95rem;
    color: var(--tinta-3);
    margin-bottom: 0.35rem;
  }
  .borrador {
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border: 1.5px solid var(--nivel-media);
    color: var(--nivel-media);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .pregunta {
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 1.9rem);
    line-height: 1.12;
    transition: color 160ms var(--ease-salida);
  }
  .enlace-caso {
    text-decoration: none;
  }
  .enlace-caso::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .enlace-caso:focus-visible {
    outline: none;
  }
  .caso:has(.enlace-caso:focus-visible) {
    outline: 3px solid var(--pluma);
    outline-offset: 2px;
  }
  .caso:hover .pregunta {
    color: var(--pluma);
  }
  .respuesta {
    margin-top: 0.4rem;
    max-width: 60ch;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--pluma);
  }
  .herramientas {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--tinta-3);
  }
  .dato {
    grid-column: 2;
    margin-top: 0.9rem;
    padding: 0.6rem 0.85rem;
    border: 1.5px solid var(--forma);
    justify-self: start;
    color: var(--pluma);
  }
  .dato .etiqueta {
    max-width: 14rem;
  }
  .valor {
    font-weight: 800;
    font-stretch: 112%;
    font-size: 2.1rem;
    line-height: 1.05;
    color: var(--pluma);
  }
  .spark {
    margin-top: 0.4rem;
  }
  @media (min-width: 48rem) {
    .caso {
      grid-template-columns: 3.5rem minmax(0, 1fr) 13rem;
    }
    .dato {
      grid-column: 3;
      margin-top: 0;
      align-self: start;
      justify-self: stretch;
    }
  }
</style>
