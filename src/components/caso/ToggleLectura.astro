---
/**
 * Interruptor "Explicación simple / Detalle técnico", como una pregunta de opción única del formulario.
 * - Sin JS: radios + CSS :has() (por defecto: simple).
 * - Con JS: guarda la preferencia (localStorage, con try/catch) y abre/cierra las capas técnicas.
 */
import { t } from "@/i18n"
---

<fieldset class="lectura">
  <legend class="etiqueta">{t("lectura.nivel")}</legend>
  <div class="opciones">
    <input type="radio" name="lectura" id="lectura-simple" value="simple" checked class="sr-only" />
    <label for="lectura-simple" class="opcion"><span class="caja" aria-hidden="true"></span><span><span class="largo">Explicación </span><span class="cap">s</span>imple</span></label>
    <input type="radio" name="lectura" id="lectura-tecnico" value="tecnico" class="sr-only" />
    <label for="lectura-tecnico" class="opcion"><span class="caja" aria-hidden="true"></span><span><span class="largo">Detalle </span><span class="cap">t</span>écnico</span></label>
  </div>
</fieldset>

<style>
  .lectura {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .lectura .etiqueta {
    margin-bottom: 0.35rem;
  }
  .opciones {
    display: flex;
    border: 2px solid var(--forma-fuerte);
  }
  .opcion {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    font-size: 1rem;
    white-space: nowrap;
    color: var(--tinta-2);
  }
  .opcion + input + .opcion,
  input + .opcion + input + .opcion {
    border-left: 1px solid var(--forma);
  }
  .caja {
    position: relative;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--forma-fuerte);
  }
  .opcion:hover {
    color: var(--tinta);
  }
  input:checked + .opcion {
    color: var(--pluma);
    font-weight: 700;
    background: var(--pluma-f);
  }
  input:checked + .opcion .caja {
    border-color: var(--pluma);
  }
  input:checked + .opcion .caja::after {
    content: "";
    position: absolute;
    inset: 2px;
    background: var(--pluma);
  }
  input:focus-visible + .opcion {
    outline: 3px solid var(--pluma);
    outline-offset: 2px;
  }
  @media (max-width: 30rem) {
    .largo {
      display: none;
    }
    .cap {
      text-transform: uppercase;
    }
  }
</style>

<script>
  const raiz = document.documentElement
  const simple = document.getElementById("lectura-simple") as HTMLInputElement | null
  const tecnico = document.getElementById("lectura-tecnico") as HTMLInputElement | null
  const capas = () => document.querySelectorAll<HTMLDetailsElement>("details.capa")

  const aplicar = (nivel: "simple" | "tecnico", guardar: boolean) => {
    raiz.dataset.lectura = nivel
    if (simple && tecnico) {
      simple.checked = nivel === "simple"
      tecnico.checked = nivel === "tecnico"
    }
    capas().forEach((d) => (d.open = nivel === "tecnico"))
    if (guardar) {
      try {
        localStorage.setItem("lectura", nivel)
      } catch {
        /* sin almacenamiento: la preferencia dura solo esta visita */
      }
    }
  }

  aplicar(raiz.dataset.lectura === "tecnico" ? "tecnico" : "simple", false)
  simple?.addEventListener("change", () => aplicar("simple", true))
  tecnico?.addEventListener("change", () => aplicar("tecnico", true))

  // Enlaces a #como-lo-hice abren la capa técnica.
  const abrirSiHash = () => {
    const destino = location.hash && document.getElementById(location.hash.slice(1))
    if (destino instanceof HTMLDetailsElement) destino.open = true
  }
  abrirSiHash()
  window.addEventListener("hashchange", abrirSiHash)
</script>
