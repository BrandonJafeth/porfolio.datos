---
import TextoGlosario from "./TextoGlosario.astro"

interface Props {
  valor: string
  etiqueta: string
  significado: string
  destacada?: boolean
}

const { valor, etiqueta, significado, destacada = false } = Astro.props
---

<div class:list={["cifra flex flex-col gap-2 border-t pt-4", destacada ? "border-accent" : "border-rule-strong"]}>
  <dt class="order-2 text-base font-bold leading-snug text-ink">{etiqueta}</dt>
  <dd class:list={["num order-1 font-serif text-5xl leading-none tracking-tight sm:text-[3.25rem]", destacada ? "text-accent" : "text-ink"]}>
    {valor}
  </dd>
  <dd class="order-3 text-base leading-relaxed text-ink-2">
    <span class="sr-only">¿Qué significa? </span><TextoGlosario texto={significado} />
  </dd>
</div>

<style>
  .cifra {
    border-top-width: 2px;
  }
</style>
