---
import ThemeToggle from "./ThemeToggle.astro"
import { PERFIL } from "@/data/perfil"
import { t } from "@/i18n"

const nav = [
  { titulo: t("nav.casos"), url: "/casos/" },
  { titulo: t("nav.indicadores"), url: "/indicadores/" },
  { titulo: t("nav.ruta"), url: "/ruta/" },
  { titulo: t("nav.sobreMi"), url: "/#sobre-mi" },
]

const actual = Astro.url.pathname
const activo = (url: string) => !url.includes("#") && actual.startsWith(url)
---

<header class="cabecera">
  <div class="contenedor flex flex-wrap items-center gap-x-6 sm:flex-nowrap">
    <a href="/" class="mr-auto flex items-baseline gap-2 py-4 no-underline">
      <span class="nombre">{PERFIL.nombreCorto}</span>
      <span class="sub">datos</span>
    </a>

    <div class="order-last -mx-1 w-full overflow-x-auto sm:order-none sm:mx-0 sm:w-auto">
      <nav aria-label={t("nav.principal")}>
        <ul class="flex whitespace-nowrap [&>li]:shrink-0">
          {
            nav.map((l) => (
              <li>
                <a href={l.url} aria-current={activo(l.url) ? "page" : undefined} class="enlace">
                  {l.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <ThemeToggle />
  </div>
</header>

<style>
  .cabecera {
    border-bottom: 2px solid var(--forma);
  }
  .nombre {
    font-family: var(--font-titulo);
    font-stretch: 125%;
    font-weight: 820;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }
  .sub {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--forma-t);
  }
  .enlace {
    display: inline-block;
    padding: 0.85rem 0.7rem;
    font-size: 1rem;
    color: var(--tinta-2);
    text-decoration: none;
    transition:
      color 160ms var(--ease-salida),
      box-shadow 160ms var(--ease-salida);
  }
  .enlace:hover {
    color: var(--tinta);
    box-shadow: inset 0 -2px 0 var(--forma-fuerte);
  }
  .enlace[aria-current="page"] {
    color: var(--tinta);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--pluma);
  }
</style>
