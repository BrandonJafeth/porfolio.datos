// Cloudflare Workers con static assets (sitio 100 % estático, sin adaptador ni código de servidor).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datos-brandoncarrillo",
  // Fecha del primer despliegue. Actualizala solo a propósito.
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // Sirve dist/404.html con estado 404 cuando una ruta no existe.
    "not_found_handling": "404-page"
  },
  // Dominio personalizado (la zona brandoncarrillo.dev ya está en Cloudflare).
  "routes": [
    { "pattern": "datos.brandoncarrillo.dev", "custom_domain": true }
  ],
  // Sin URL *.workers.dev pública: solo el dominio propio.
  "workers_dev": false,
  "preview_urls": false
}
